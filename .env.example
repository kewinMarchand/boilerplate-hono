# Copier en .env pour surcharger les valeurs par défaut (fichier non versionné).
# Les identifiants MongoDB de compose.yaml sont ceux d'une base locale non exposée : aucun secret ici.

# Port publié sur 127.0.0.1
API_PORT=8091

# dev | test | prod. X-Scenario n'est actif qu'en dev et en test.
APP_ENV=dev

# Origines CORS autorisées (expression régulière, insensible à la casse)
CORS_ALLOW_ORIGIN=^http://(localhost|127\.0\.0\.1):(3000|3010|4321|5173|8095|18095|4[01][0-9]{2})$

# Mails du formulaire de contact (SMTP, smtp:// ou smtps://). Le compose pointe sur Mailpit (smtp://mailpit:1025),
# dont l'interface est sur http://localhost:8027. Le destinataire se règle dans l'admin (Identité du site).
MAILER_FROM=site@example.com
# Port de l'interface de Mailpit, publié sur 127.0.0.1
MAILPIT_PORT=8027

# Suivi des erreurs dans GlitchTip (DSN au format Sentry). Vide : SDK non initialisé, rien n'est envoyé.
GLITCHTIP_DSN=
# Environnement remonté avec chaque erreur. Vide : la valeur de APP_ENV.
GLITCHTIP_ENVIRONMENT=

# Clé des sessions de l'admin (/admin), 32 caractères au moins, obligatoire en production : openssl rand -hex 32
ADMIN_SESSION_SECRET=
