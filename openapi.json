{
    "openapi": "3.1.0",
    "info": {
        "title": "API de test Kewin",
        "description": "API de test commune aux boilerplates front (Next, Nuxt, SvelteKit, Symfony Twig, HTML).\nImplémentation Hono, zod et MongoDB, interchangeable avec boilerplate-api-platform : mêmes chemins, mêmes paramètres, mêmes formes JSON.\nFormat : JSON simple (`application/json`).\nEn dev et en test, l'en-tête `X-Scenario: error` renvoie une 500 et `X-Scenario: empty` une collection vide.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": ""
        }
    ],
    "components": {
        "schemas": {
            "Task": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "done": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "title",
                    "done"
                ],
                "description": "Liste toutes les tâches, sans pagination."
            },
            "Article": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "excerpt": {
                        "type": "string"
                    },
                    "publishedAt": {
                        "type": "string",
                        "format": "date"
                    },
                    "image": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ImageView"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "title",
                    "excerpt",
                    "publishedAt",
                    "image"
                ],
                "description": "Liste les articles, du plus récent au plus ancien, sans pagination."
            },
            "ImageView": {
                "type": "object",
                "properties": {
                    "alt": {
                        "type": "string",
                        "description": "Texte de remplacement. Vide : image décorative."
                    },
                    "width": {
                        "type": "integer",
                        "description": "Largeur de la plus grande variante, en pixels (attribut width)."
                    },
                    "height": {
                        "type": "integer",
                        "description": "Hauteur de la plus grande variante, en pixels (attribut height)."
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ImageSource"
                        },
                        "description": "Sources du <picture>, AVIF puis WebP."
                    },
                    "src": {
                        "type": "string",
                        "description": "Adresse absolue de la plus petite variante WebP (attribut src de l'<img>)."
                    }
                },
                "required": [
                    "alt",
                    "width",
                    "height",
                    "sources",
                    "src"
                ],
                "description": "Image exposée dans le contrat public (ADR 0002) : les fronts posent les sources dans un <picture>, sans construire aucun chemin."
            },
            "ImageSource": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "image/avif",
                            "image/webp"
                        ],
                        "description": "Type MIME de la source : image/avif, puis image/webp."
                    },
                    "srcset": {
                        "type": "string",
                        "description": "Valeur de l'attribut srcset : adresses absolues et largeurs, de la plus petite à la plus grande."
                    }
                },
                "required": [
                    "type",
                    "srcset"
                ],
                "description": "Une source d'un élément <picture> : un format et toutes ses largeurs."
            },
            "ArticleDetail": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "excerpt": {
                        "type": "string"
                    },
                    "publishedAt": {
                        "type": "string",
                        "format": "date"
                    },
                    "image": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ImageView"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "html": {
                        "type": "string",
                        "description": "Texte de l'article en HTML, converti du Markdown saisi (HTML saisi échappé, liens dangereux retirés). Vide s'il n'y en a pas."
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "title",
                    "excerpt",
                    "publishedAt",
                    "image",
                    "html"
                ],
                "description": "Lit un article par son slug."
            },
            "Error": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true,
                        "description": "A short, human-readable summary of the problem."
                    },
                    "detail": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true,
                        "description": "A human-readable explanation specific to this occurrence of the problem."
                    },
                    "status": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "default": 400,
                        "examples": [
                            404
                        ]
                    },
                    "instance": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true,
                        "description": "A URI reference that identifies the specific occurrence of the problem. It may or may not yield further information if dereferenced."
                    },
                    "type": {
                        "type": "string",
                        "readOnly": true,
                        "description": "A URI reference that identifies the problem type"
                    }
                },
                "description": "A representation of common errors."
            },
            "ContactMessage": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "readOnly": true
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 2,
                        "maxLength": 255
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255,
                        "format": "email"
                    },
                    "message": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 10,
                        "maxLength": 5000
                    },
                    "receivedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "name",
                    "email",
                    "message"
                ],
                "description": "Enregistre un message de contact. Répond 422 avec la liste des violations si un champ est invalide."
            },
            "ConstraintViolation": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "integer",
                        "default": 422
                    },
                    "violations": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "propertyPath": {
                                    "type": "string",
                                    "description": "The property path of the violation"
                                },
                                "message": {
                                    "type": "string",
                                    "description": "The message associated with the violation"
                                },
                                "code": {
                                    "type": "string",
                                    "description": "The code of the violation"
                                },
                                "hint": {
                                    "type": "string",
                                    "description": "An extra hint to understand the violation"
                                },
                                "payload": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "description": "The serialized payload of the violation"
                                }
                            },
                            "required": [
                                "propertyPath",
                                "message"
                            ]
                        }
                    },
                    "detail": {
                        "type": "string",
                        "readOnly": true
                    },
                    "type": {
                        "type": "string",
                        "readOnly": true
                    },
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true
                    },
                    "instance": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "readOnly": true
                    }
                },
                "description": "Unprocessable entity"
            },
            "Category": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "parent": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Slug de la catégorie parente, null à la racine."
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Category"
                        }
                    }
                },
                "required": [
                    "slug",
                    "name",
                    "parent",
                    "children"
                ],
                "description": "Renvoie l'arbre des catégories : les catégories racines, chacune avec ses enfants, triées par position."
            },
            "ProductList": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductItem"
                        }
                    },
                    "totalItems": {
                        "type": "integer",
                        "description": "Nombre total de produits filtrés, toutes pages confondues."
                    },
                    "page": {
                        "type": "integer"
                    },
                    "itemsPerPage": {
                        "type": "integer"
                    },
                    "totalPages": {
                        "type": "integer",
                        "description": "Nombre de pages, 0 si aucun résultat."
                    },
                    "facets": {
                        "$ref": "#/components/schemas/ProductFacets"
                    }
                },
                "required": [
                    "items",
                    "totalItems",
                    "page",
                    "itemsPerPage",
                    "totalPages",
                    "facets"
                ],
                "description": "Liste les produits du catalogue. Les filtres se combinent en ET, les valeurs d'une même facette en OU. Une valeur invalide (inconnue, non numérique, hors bornes) est ignorée et remplacée par la valeur par défaut."
            },
            "ProductItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "categorySlug": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer",
                        "description": "Prix en centimes."
                    },
                    "exposure": {
                        "type": "string",
                        "enum": [
                            "soleil",
                            "mi-ombre",
                            "ombre"
                        ]
                    },
                    "size": {
                        "type": "string",
                        "enum": [
                            "S",
                            "M",
                            "L"
                        ]
                    },
                    "inStock": {
                        "type": "boolean"
                    },
                    "image": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ImageView"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "name",
                    "categorySlug",
                    "price",
                    "exposure",
                    "size",
                    "inStock",
                    "image"
                ]
            },
            "ProductFacets": {
                "type": "object",
                "properties": {
                    "exposure": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetValue"
                        },
                        "description": "Toutes les expositions, y compris à 0."
                    },
                    "size": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FacetValue"
                        },
                        "description": "Toutes les tailles, y compris à 0."
                    },
                    "category": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryFacetValue"
                        },
                        "description": "Sous-catégories directes de la catégorie filtrée (catégories racines sans filtre). Vide sur une feuille."
                    }
                },
                "required": [
                    "exposure",
                    "size",
                    "category"
                ]
            },
            "FacetValue": {
                "type": "object",
                "properties": {
                    "value": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Nombre de produits obtenus en ajoutant cette valeur aux filtres des autres facettes."
                    }
                },
                "required": [
                    "value",
                    "count"
                ]
            },
            "CategoryFacetValue": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Nombre de produits de cette sous-catégorie qui respectent les autres filtres."
                    }
                },
                "required": [
                    "slug",
                    "name",
                    "count"
                ]
            },
            "ProductDetail": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "categorySlug": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer",
                        "description": "Prix en centimes."
                    },
                    "exposure": {
                        "type": "string",
                        "enum": [
                            "soleil",
                            "mi-ombre",
                            "ombre"
                        ]
                    },
                    "size": {
                        "type": "string",
                        "enum": [
                            "S",
                            "M",
                            "L"
                        ]
                    },
                    "inStock": {
                        "type": "boolean"
                    },
                    "image": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ImageView"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "categoryPath": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryLink"
                        },
                        "description": "Catégories de la racine à celle du produit, pour le fil d'Ariane."
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "name",
                    "categorySlug",
                    "price",
                    "exposure",
                    "size",
                    "inStock",
                    "image",
                    "categoryPath"
                ],
                "description": "Lit un produit par son slug."
            },
            "CategoryLink": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "slug",
                    "name"
                ]
            },
            "FeaturedProduct.ProductItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "categorySlug": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer",
                        "description": "Prix en centimes."
                    },
                    "exposure": {
                        "type": "string",
                        "enum": [
                            "soleil",
                            "mi-ombre",
                            "ombre"
                        ]
                    },
                    "size": {
                        "type": "string",
                        "enum": [
                            "S",
                            "M",
                            "L"
                        ]
                    },
                    "inStock": {
                        "type": "boolean"
                    },
                    "image": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/ImageView"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "name",
                    "categorySlug",
                    "price",
                    "exposure",
                    "size",
                    "inStock",
                    "image"
                ],
                "description": "Liste les produits à la une par ordre alphabétique, sans pagination."
            },
            "LegalPage": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "introduction": {
                        "type": "string"
                    },
                    "sections": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LegalSection"
                        }
                    }
                },
                "required": [
                    "slug",
                    "title",
                    "introduction",
                    "sections"
                ],
                "description": "Lit une page légale par son slug (mentions-legales, donnees-personnelles, accessibilite)."
            },
            "LegalSection": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "html": {
                        "type": "string"
                    }
                },
                "required": [
                    "title",
                    "html"
                ]
            }
        },
        "parameters": {}
    },
    "paths": {
        "/api/tasks": {
            "get": {
                "operationId": "api_tasks_get_collection",
                "tags": [
                    "Task"
                ],
                "summary": "Retrieves the collection of Task resources.",
                "description": "Retrieves the collection of Task resources.",
                "responses": {
                    "200": {
                        "description": "Task collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Task"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/articles": {
            "get": {
                "operationId": "api_articles_get_collection",
                "tags": [
                    "Article"
                ],
                "summary": "Retrieves the collection of Article resources.",
                "description": "Retrieves the collection of Article resources.",
                "responses": {
                    "200": {
                        "description": "Article collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Article"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/articles/{slug}": {
            "get": {
                "operationId": "api_articles_slug_get",
                "tags": [
                    "ArticleDetail"
                ],
                "summary": "Retrieves a ArticleDetail resource.",
                "description": "Retrieves a ArticleDetail resource.",
                "parameters": [
                    {
                        "schema": {
                            "type": "string",
                            "description": "ArticleDetail identifier"
                        },
                        "required": true,
                        "description": "ArticleDetail identifier",
                        "name": "slug",
                        "in": "path"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ArticleDetail resource",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ArticleDetail"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/contact_messages": {
            "post": {
                "operationId": "api_contact_messages_post",
                "tags": [
                    "ContactMessage"
                ],
                "summary": "Creates a ContactMessage resource.",
                "description": "Creates a ContactMessage resource.",
                "requestBody": {
                    "required": true,
                    "description": "The new ContactMessage resource",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "minLength": 2,
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255,
                                        "format": "email"
                                    },
                                    "message": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "minLength": 10,
                                        "maxLength": 5000
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "ContactMessage resource created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ContactMessage"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "413": {
                        "description": "Payload too large",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "An error occurred",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConstraintViolation"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConstraintViolation"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/categories": {
            "get": {
                "operationId": "api_categories_get_collection",
                "tags": [
                    "Category"
                ],
                "summary": "Retrieves the collection of Category resources.",
                "description": "Renvoie l'arbre des catégories : les catégories racines, chacune avec ses enfants, triées par position.",
                "responses": {
                    "200": {
                        "description": "Category collection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Category"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "operationId": "api_products_get",
                "tags": [
                    "ProductList"
                ],
                "summary": "Retrieves a ProductList resource.",
                "description": "Liste les produits du catalogue. Les filtres se combinent en ET, les valeurs d'une même facette en OU. Une valeur invalide (inconnue, non numérique, hors bornes) est ignorée et remplacée par la valeur par défaut.",
                "parameters": [
                    {
                        "schema": {
                            "type": "string",
                            "description": "Slug de catégorie : inclut toute la branche. Slug inconnu : 404."
                        },
                        "required": false,
                        "description": "Slug de catégorie : inclut toute la branche. Slug inconnu : 404.",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "soleil",
                                    "mi-ombre",
                                    "ombre"
                                ]
                            },
                            "description": "Expositions acceptées, clé répétée : exposure[]=soleil&exposure[]=ombre."
                        },
                        "required": false,
                        "description": "Expositions acceptées, clé répétée : exposure[]=soleil&exposure[]=ombre.",
                        "name": "exposure[]",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "S",
                                    "M",
                                    "L"
                                ]
                            },
                            "description": "Tailles acceptées, clé répétée : size[]=S&size[]=M."
