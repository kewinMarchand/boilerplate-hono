{
  "name": "boilerplate-hono",
  "version": "1.0.0",
  "private": true,
  "description": "API de test NoSQL (Hono, zod, MongoDB), interchangeable avec boilerplate-api-platform",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "db:reset": "node src/scripts/dbReset.ts",
    "db:translations": "node src/scripts/addFixtureTranslations.ts",
    "admin:create": "node src/scripts/createAdmin.ts",
    "openapi": "node src/scripts/exportOpenapi.ts openapi.json",
    "contract": "node contract/compare.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=26.13.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "^11.10.0",
    "hono": "^4.13.16",
    "markdown-it": "^14.1.0",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.4.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
